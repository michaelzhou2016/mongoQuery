[
    {
        "$match": {
            "$and": [
                {
                    "requesttime": {
                        "$gte": "20251222000000",
                        "$lte": "20251231142359"
                    }
                },
                {
                    "packagename": {
                        "$in": [
                            "NE1KN^ICHN^01"
                        ]
                    }
                },
                {
                    "targetEventID": {
                        "$in": [
                            "P0199PCE07ICHN10_010"
                        ]
                    }
                },
                {
                    "targetEventName": {
                        "$in": [
                            "NE1KN_ccNC_CHN_2501RU"
                        ]
                    }
                },
                {
                    "testDv": {
                        "$in": [
                            "P"
                        ]
                    }
                }
            ]
        }
    },
    {
        "$group": {
            "_id": {
                "vin": "$vin",
                "partNo": "$partNo"
            },
            "maxCreatedAt": {
                "$max": "$createdAt"
            }
        }
    },
    {
        "$lookup": {
            "from": "StatDeviceDownload",
            "let": {
                "vin": "$_id.vin",
                "partNo": "$_id.partNo",
                "createdAt": "$maxCreatedAt"
            },
            "pipeline": [
                {
                    "$match": {
                        "$expr": {
                            "$and": [
                                {
                                    "$eq": [
                                        "$vin",
                                        "$$vin"
                                    ]
                                },
                                {
                                    "$eq": [
                                        "$partNo",
                                        "$$partNo"
                                    ]
                                },
                                {
                                    "$eq": [
                                        "$createdAt",
                                        "$$createdAt"
                                    ]
                                }
                            ]
                        }
                    }
                }
            ],
            "as": "matchdata"
        }
    },
    {
        "$unwind": "$matchdata"
    },
    {
        "$facet": {
            "download_ing_data": [
                {
                    "$match": {
                        "$and": [
                            {
                                "matchdata.downloadresult": {
                                    "$in": [
                                        "0"
                                    ]
                                }
                            }
                        ]
                    }
                },
                {
                    "$group": {
                        "_id": {
                            "partNo": "$matchdata.partNo",
                            "targetEventID": "$matchdata.targetEventID",
                            "downloadresult": "$matchdata.downloadresult"
                        },
                        "downloadresultcount": {
                            "$sum": 1
                        }
                    }
                },
                {
                    "$group": {
                        "_id": {
                            "partNo": "$_id.partNo",
                            "targetEventID": "$_id.targetEventID"
                        },
                        "downloadresults": {
                            "$push": {
                                "downloadresult": "$_id.downloadresult",
                                "count": "$downloadresultcount"
                            }
                        },
                        "count": {
                            "$sum": "$downloadresultcount"
                        }
                    }
                }
            ],
            "update_ing_data": [
                {
                    "$match": {
                        "$and": [
                            {
                                "matchdata.reportCode": {
                                    "$in": [
                                        "1002"
                                    ]
                                }
                            },
                            {
                                "matchdata.isresultCode": ""
                            }
                        ]
                    }
                },
                {
                    "$group": {
                        "_id": {
                            "partNo": "$matchdata.partNo",
                            "targetEventID": "$matchdata.targetEventID",
                            "reportCode": "$matchdata.reportCode"
                        },
                        "reportCodecount": {
                            "$sum": 1
                        }
                    }
                },
                {
                    "$group": {
                        "_id": {
                            "partNo": "$_id.partNo",
                            "targetEventID": "$_id.targetEventID"
                        },
                        "reportCodes": {
                            "$push": {
                                "reportCode": "$_id.reportCode",
                                "count": "$reportCodecount"
                            }
                        },
                        "count": {
                            "$sum": "$reportCodecount"
                        }
                    }
                }
            ],
            "download_data": [
                {
                    "$group": {
                        "_id": {
                            "partNo": "$matchdata.partNo",
                            "targetEventID": "$matchdata.targetEventID",
                            "srresultCode": "$matchdata.srresultCode"
                        },
                        "srresultCodecount": {
                            "$sum": 1
                        }
                    }
                },
                {
                    "$group": {
                        "_id": {
                            "partNo": "$_id.partNo",
                            "targetEventID": "$_id.targetEventID"
                        },
                        "srresultCodes": {
                            "$push": {
                                "srresultCode": "$_id.srresultCode",
                                "count": "$srresultCodecount"
                            }
                        },
                        "count": {
                            "$sum": "$srresultCodecount"
                        }
                    }
                }
            ],
            "update_data": [
                {
                    "$group": {
                        "_id": {
                            "partNo": "$matchdata.partNo",
                            "targetEventID": "$matchdata.targetEventID",
                            "isresultCode": "$matchdata.isresultCode"
                        },
                        "isresultCodecount": {
                            "$sum": 1
                        }
                    }
                },
                {
                    "$group": {
                        "_id": {
                            "partNo": "$_id.partNo",
                            "targetEventID": "$_id.targetEventID"
                        },
                        "isresultCodes": {
                            "$push": {
                                "isresultCode": "$_id.isresultCode",
                                "count": "$isresultCodecount"
                            }
                        },
                        "count": {
                            "$sum": "$isresultCodecount"
                        }
                    }
                }
            ],
            "vin_count": [
                {
                    "$group": {
                        "_id": {
                            "partNo": "$matchdata.partNo",
                            "targetEventID": "$matchdata.targetEventID"
                        },
                        "vins": {
                            "$addToSet": "$matchdata.vin"
                        }
                    }
                },
                {
                    "$unwind": "$vins"
                },
                {
                    "$group": {
                        "_id": "$_id",
                        "carCount": {
                            "$sum": 1
                        }
                    }
                }
            ],
            "download_fail_data": [
                {
                    "$match": {
                        "$and": [
                            {
                                "matchdata.srresultCode": {
                                    "$in": [
                                        "901",
                                        "903",
                                        "905",
                                        "951",
                                        "952",
                                        "953",
                                        "954"
                                    ]
                                }
                            }
                        ]
                    }
                },
                {
                    "$group": {
                        "_id": {
                            "partNo": "$matchdata.partNo",
                            "targetEventID": "$matchdata.targetEventID",
                            "sourceEventID": "$matchdata.sourceEventID",
                            "srresultCode": "$matchdata.srresultCode",
                            "vin": "$matchdata.vin"
                        }
                    }
                },
                {
                    "$group": {
                        "_id": {
                            "partNo": "$_id.partNo",
                            "targetEventID": "$_id.targetEventID"
                        },
                        "downloadFailDetail": {
                            "$push": {
                                "sourceEventID": "$_id.sourceEventID",
                                "srresultCode": "$_id.srresultCode",
                                "vin": "$_id.vin"
                            }
                        }
                    }
                }
            ],
            "update_fail_data": [
                {
                    "$match": {
                        "$and": [
                            {
                                "matchdata.isresultCode": {
                                    "$in": [
                                        "1400",
